# ==============================================================
# MediSync Configuration Environment Variables
# ==============================================================

# Application Port & Environment
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration
# MongoDB connection string. If MongoDB is not running locally, MediSync
# automatically falls back to an embedded MongoDB instance for seamless local dev.
MONGODB_URI=mongodb://localhost:27017/medisync

# Redis Configuration (Used for BullMQ scheduled notification jobs)
REDIS_URL=redis://127.0.0.1:6379

# Authentication (JWT)
# IMPORTANT: Replace with a cryptographically secure random string in production!
JWT_SECRET=medisync_super_secret_jwt_key_replace_in_production_1234567890
JWT_EXPIRES_IN=7d

# Default Timezone for Schedules
DEFAULT_TIMEZONE=Asia/Kolkata

# Email Delivery (Nodemailer / SMTP)
# Leave blank to use Mock/Preview delivery mode (emails logged & saved to notification history)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MediSync Healthcare <reminders@medisync.local>"

# Demonstration Mode Configuration
# Enables accelerated escalation timelines (seconds instead of hours) for live presentations
ENABLE_DEMO_MODE=true
# Demo escalation timing in seconds (Stage 2 follow-up: 30s, Stage 3 caregiver: 60s, Stage 4 healthcare: 120s)
DEMO_STAGE2_SECONDS=30
DEMO_STAGE3_SECONDS=60
DEMO_STAGE4_SECONDS=120
