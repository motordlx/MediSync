# ==============================================================
# MediSync .gitignore
# ==============================================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
*.env
*.env.local
server/.env
client/.env

# Local Database & Runtime Data
server/data/
data/
*.wt
*.turtle
diagnostic.data/
active-mongo-uri.txt
*.lock

# Build & Distribution Artifacts
dist/
client/dist/
build/
.cache/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Coverage
coverage/
*.lcov
.nyc_output/

# IDE & Editor Files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
